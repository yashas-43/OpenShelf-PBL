PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/openshelf?replicaSet=rs0&directConnection=true
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=2h
# Recommended: generate a different random secret for OTP and reset tokens.
RESET_TOKEN_SECRET=replace_with_another_32_character_random_secret

# New self-service physical checkout starts the due-date clock when Borrow is clicked (1–60 days, default 14).
LOAN_DAYS=14
# MongoDB must be configured as a replica set for transactional borrowing.
# Example URI after enabling a local single-node replica set:
# MONGODB_URI=mongodb://127.0.0.1:27017/openshelf?replicaSet=rs0

# Admin login: generate a bcrypt hash; never put a plain password here.
ADMIN_NAME=OpenShelf Administrator
ADMIN_EMAIL=openshelfofficial01@gmail.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Gmail SMTP registration confirmation (use a Google App Password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_character_google_app_password
EMAIL_FROM=OpenShelf <youraddress@gmail.com>

# Exact local directory containing Class 8, Class 9, Class 10, 1st Puc and 2nd Puc.
# Files remain on your Windows laptop; the importer does not copy them.
TEXTBOOKS_ROOT=D:\Library\Textbooks

# Phase 10: In-app email job polls while the API is running (set true after SMTP setup).
EMAIL_JOBS_ENABLED=false
EMAIL_JOBS_INTERVAL_MINUTES=60
# Password-reset verification codes: 10 minutes, 5 attempts, 60-second resend cooldown.

# Phase 11: optionally store uploaded General Book cover images outside source control.
# By default, covers are stored in server/cover-uploads/ (created at first upload).
# BOOK_COVER_ROOT=D:\Library\OpenShelf-Covers
# Multipart admin PDF uploads are stored under TEXTBOOKS_ROOT/admin-uploads.
# The local manifest importer remains preferred for large textbook files.

# Phase 13 (optional): local private storage for peer-uploaded book photos.
# Relative to the backend working directory if omitted. Only images are accepted, never PDFs.
PEER_PHOTO_ROOT=

# DEMO QR MODE: local/classroom only; never creates real payments.
# Add this to your existing server/.env after extracting the new ZIP.
DEMO_QR_ENABLED=true

# Razorpay is paused when DEMO_QR_ENABLED=true. Test keys may be left blank.
# Razorpay TEST MODE ONLY. No live charges can occur in this demo build.
# Obtain test keys from Razorpay dashboard > Test Mode > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subject fee: fixed ₹10 per group (including all PDFs within the subject).
# Student PDFs need admin-confirmed distribution rights and an actual local PDF before checkout.
# Existing payment/purchase records are preserved; old ₹1 pending orders will not be reused.

# Registration: six-digit Gmail OTP; no SMS service is used.
# Phone number remains a required 10-digit contact field and may be shared.
# EMAIL_HOST, EMAIL_USER and EMAIL_PASS must be configured for new registrations.
# Generate a different strong secret for HMAC-protected registration codes.
REGISTRATION_OTP_SECRET=replace_with_another_32_plus_character_random_secret

# Physical returns after the deadline incur a one-time ₹10 fine per overdue loan.
# Fine is assessed when staff confirms return. Outstanding fines are visible on dashboards.
# Fine collection is recorded but NOT processed through Razorpay in this edition.

# Phase 14: In-app due reminders are independent from SMTP.
NOTIFICATION_JOBS_ENABLED=true
NOTIFICATION_JOBS_INTERVAL_MINUTES=60

# Phase 15 security preflight:
# - Server startup refuses placeholder/weak JWT_SECRET or ADMIN_PASSWORD_HASH.
# - ADMIN_EMAIL must be openshelfofficial01@gmail.com.
# - Production additionally requires distinct RESET_TOKEN_SECRET and
#   REGISTRATION_OTP_SECRET, and a secure HTTPS CLIENT_URL origin.
# - MongoDB indexes for unique accounts, one-time codes, loan safety and
#   peer-exchange requests are checked on startup. Keep a DB backup.
# - Changing ADMIN_PASSWORD_HASH logs out existing administrator sessions.
