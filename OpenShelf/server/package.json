    "catalogue:text-index:apply": "node src/scripts/repairGeneralBookTextIndex.js --apply"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0",
    "openshelf": "file:.."
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
