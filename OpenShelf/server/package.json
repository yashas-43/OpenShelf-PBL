{
  "name": "openshelf-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "hash-password": "node src/scripts/hashPassword.js",
    "test": "node --test src/tests/*.test.js",
    "audit:stock": "node src/scripts/auditBorrowingStock.js",
    "pdf:check": "node src/scripts/importStudentPdfs.js --check",
    "pdf:import": "node src/scripts/importStudentPdfs.js --import",
    "stock:set-three": "node src/scripts/setThreeCopyInventory.js",
    "catalogue:check": "node src/scripts/importGeneralBooks.js --check",
    "catalogue:preview": "node src/scripts/importGeneralBooks.js --preview",
    "catalogue:apply": "node src/scripts/importGeneralBooks.js --apply",
    "email:process": "node src/scripts/processEmails.js",
    "audit:student-stock": "node src/scripts/auditStudentStock.js",
    "notifications:process": "node src/scripts/processNotifications.js",
    "stock:student-three": "node src/scripts/setStudentPhysicalInventory.js",
    "accounts:reset": "node src/scripts/retireStudentAccounts.js",
    "catalogue:duplicates:preview": "node src/scripts/auditGeneralBookDuplicates.js --preview",
    "catalogue:duplicates:apply": "node src/scripts/auditGeneralBookDuplicates.js --apply",
